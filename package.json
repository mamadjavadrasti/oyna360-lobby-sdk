{
  "name": "@oyna360/lobby-sdk",
  "version": "0.4.1",
  "description": "oyna360 Lobby SDK — connect your existing game lobby to Oyna360 and receive player, room, and avatar data. Engine-independent.",
  "license": "MIT",
  "author": "oyna360",
  "keywords": [
    "oyna360",
    "lobby-sdk",
    "multiplayer",
    "avatar",
    "websocket"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync:protocol": "node ./scripts/prebuild.mjs",
    "prebuild": "node ./scripts/prebuild.mjs",
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "lint": "echo \"No lint configured for @oyna360/lobby-sdk\"",
    "check:protocol": "node ./scripts/prebuild.mjs --check"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mamadjavadrasti/oyna360-lobby-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mamadjavadrasti/oyna360-lobby-sdk/issues"
  },
  "homepage": "https://github.com/mamadjavadrasti/oyna360-lobby-sdk#readme",
  "publishConfig": {
    "access": "public"
  }
}
